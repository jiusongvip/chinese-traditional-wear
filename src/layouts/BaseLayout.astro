---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  articleDate?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = "/images/og-chinese-traditional-wear.webp",
  articleDate,
  breadcrumbs,
} = Astro.props;

const SITE_URL = "https://chinesetraditionalwear.com";
const pageUrl = canonicalUrl ? `${SITE_URL}${canonicalUrl}` : SITE_URL;
const SITE_NAME = "ChinaStyle";
const AUTHOR_NAME = "Li Wei";
const AUTHOR_URL = "https://chinesetraditionalwear.com/about";

// Precompute all schema JSON-LD strings to avoid Astro template parsing issues
const schemaOrganization = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE_NAME,
  "url": SITE_URL,
  "description": "Your comprehensive guide to Chinese traditional wear — Hanfu (汉服), Qipao (旗袍), Tang suits (唐装), and more. Explore history, styles, and where to experience Chinese clothing firsthand.",
  "sameAs": []
});

const schemaWebsite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL
});

const schemaArticle = canonicalUrl ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Organization",
    "name": AUTHOR_NAME,
    "url": AUTHOR_URL
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_NAME,
    "url": SITE_URL
  },
  "datePublished": articleDate || "2026-08-03",
  "dateModified": articleDate || "2026-08-03",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  }
}) : "";

const isFAQPage = canonicalUrl === "/faq/";
const schemaFAQ = isFAQPage ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where can I try on Chinese traditional clothing in China?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The best cities are Xi'an (Hanfu photoshoots), Shanghai (qipao tailoring), Beijing (Tang suit workshops), Suzhou (silk qipao), and Guizhou (Miao embroidery). Most major museums including the China National Silk Museum in Hangzhou offer costume try-on sessions."
      }
    },
    {
      "@type": "Question",
      "name": "Which city is best for Hanfu experiences?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Xi'an tops the list with the ancient city wall, Daming Palace ruins, and Datang Everbright City packed with Hanfu rental shops. Luoyang and Chengdu are close seconds."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a Hanfu rental and photoshoot cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Basic Hanfu rental 100-200 RMB for 2-4 hours. Premium sets with makeup 300-500 RMB. Full photoshoot package 500-1500 RMB."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I buy authentic Chinese traditional clothing while traveling?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Shanghai's South Bund Fabric Market for custom qipao, Beijing's Silk Street for Tang suits, Suzhou for silk brocades, and Kaili (Guizhou) or Dali (Yunnan) for ethnic minority textiles."
      }
    },
    {
      "@type": "Question",
      "name": "What is Chinese traditional wear called?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hanfu for traditional Han Chinese clothing from ancient dynasties, Qipao/Cheongsam for the 1920s Shanghai dress, and Tang suit for the mandarin-collared jacket worn for festivals."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Hanfu and Qipao?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hanfu dates back 3,000+ years with loose flowing robes and crossed collars. Qipao emerged in 1920s Shanghai with a form-fitting one-piece silhouette, high mandarin collar, and side slits."
      }
    },
    {
      "@type": "Question",
      "name": "Is it appropriate for non-Chinese people to wear traditional Chinese clothing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally yes, when worn with respect and understanding of cultural context. Many Chinese cultural organizations and historical sites actively encourage visitors to try on traditional clothing."
      }
    },
    {
      "@type": "Question",
      "name": "What did Chinese emperors wear?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Chinese emperors wore the dragon robe (longpao) in brilliant yellow silk embroidered with nine dragons, clouds, and waves. You can see original robes at the Palace Museum in Beijing's Forbidden City."
      }
    }
  ]
}) : "";

const schemaBreadcrumbs = (breadcrumbs && breadcrumbs.length > 0) ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": SITE_URL + b.url
  }))
}) : "";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={canonicalUrl ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={`${SITE_URL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${ogImage}`} />

    {articleDate && (
      <>
        <meta property="article:published_time" content={articleDate} />
        <meta property="article:modified_time" content={articleDate} />
      </>
    )}

    <!-- Schema: Organization -->
    <script type="application/ld+json" set:html={schemaOrganization}></script>

    <!-- Schema: WebSite -->
    <script type="application/ld+json" set:html={schemaWebsite}></script>


    <!-- Schema: Article (for content pages) -->
    {canonicalUrl && <script type="application/ld+json" set:html={schemaArticle}></script>}

    <!-- Schema: FAQPage (for pages with FAQ content) -->
    {isFAQPage && <script type="application/ld+json" set:html={schemaFAQ}></script>}

    {breadcrumbs && breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={schemaBreadcrumbs}></script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-white text-stone-900 font-sans antialiased">
    <header class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-md border-b border-stone-100">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="font-serif-sc font-bold text-xl text-stone-900 tracking-tight">ChinaStyle</span>
        </a>
        <div class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-600">
          <a href="/hanfu" class="hover:text-stone-900 transition-colors">Experiences</a>
          <a href="/dynasties" class="hover:text-stone-900 transition-colors">Destinations</a>
          <a href="/plan-trip" class="hover:text-stone-900 transition-colors">Plan Your Trip</a>
          <a href="/gallery" class="hover:text-stone-900 transition-colors">Gallery</a>
        </div>
        <button class="md:hidden text-stone-600" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bg-stone-950 text-stone-400 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <span class="text-white font-serif-sc font-bold text-lg">ChinaStyle</span>
            <p class="mt-3 text-sm leading-relaxed">Discover where to experience Chinese traditional clothing firsthand.</p>
          </div>
          <div>
            <h4 class="text-white text-sm font-semibold mb-3">Experiences</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/hanfu" class="hover:text-white transition-colors">Hanfu Photoshoots</a></li>
              <li><a href="/qipao-cheongsam" class="hover:text-white transition-colors">Qipao Tailoring</a></li>
              <li><a href="/tang-suit" class="hover:text-white transition-colors">Tang Suit Workshops</a></li>
              <li><a href="/ethnic" class="hover:text-white transition-colors">Ethnic Textile Villages</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white text-sm font-semibold mb-3">Plan Your Trip</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/plan-trip" class="hover:text-white transition-colors">Travel Guide & Itineraries</a></li>
              <li><a href="/dynasties" class="hover:text-white transition-colors">Destinations Map</a></li>
              <li><a href="/how-to-wear" class="hover:text-white transition-colors">What to Expect</a></li>
              <li><a href="/faq" class="hover:text-white transition-colors">Travel FAQ</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white text-sm font-semibold mb-3">More</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/gallery" class="hover:text-white transition-colors">Travel Gallery</a></li>
              <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
              <li><a href="/compare" class="hover:text-white transition-colors">Style Comparisons</a></li>
              <li><a href="/accessories" class="hover:text-white transition-colors">Accessories Guide</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-stone-800 text-xs text-stone-500 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
          <span>&copy; {new Date().getFullYear()} ChinaStyle. A cultural travel guide to Chinese traditional clothing experiences.</span>
          <span class="flex gap-4"><a href="/contact" class="hover:text-stone-300 transition-colors">Contact</a><a href="/privacy" class="hover:text-stone-300 transition-colors">Privacy</a></span>
        </div>
    </footer>
  </body>
</html>

<style is:global>
  .font-serif-sc {
    font-family: ''Noto Serif SC'', serif;
  }
  .font-sans {
    font-family: ''Outfit'', system-ui, sans-serif;
  }
</style>
