---
import BaseLayout from "../../layouts/BaseLayout.astro";

const dynasties = [
  {
    name: "Han", nameCN: "汉", period: "206 BC – 220 AD",
    img: "/images/dyn-han.webp",
    desc: "The Han dynasty gave us the very word 'Hanfu' (汉服) — clothing of the Han people. The classic Han silhouette featured a wrapped outer robe (jiaoling youren, meaning crossed collar worn right-over-left) with deep overlapping lapels and wide, flowing sleeves that could extend past the fingertips. A sash (dadai) cinched the waist, often with jade ornaments hanging from the belt.",
    details: "Silk was the prestige fabric, with sericulture flourishing along the Silk Road's eastern terminus in Chang'an (modern Xi'an). Commoners wore hemp and ramie. Color hierarchy was strict: officials wore specific colors and patterns based on their rank, while the emperor alone could wear certain shades of yellow.",
    destination: "Xi'an — walk the Silk Road starting point, visit the Shaanxi History Museum for Han dynasty textile remnants.",
    destLabel: "Best place to experience"
  },
  {
    name: "Tang", nameCN: "唐", period: "618 – 907 AD",
    img: "/images/dyn-tang.webp",
    desc: "The Tang era was China's most cosmopolitan period — and its most daring in fashion. Women wore high-waisted ruqun skirts cinched above the chest, paired with short, open-front jackets (banbi) that exposed the neck and collarbone. Bold colors ruled: crimson, imperial yellow, emerald green.",
    details: "Central Asian and Persian influences arrived via the Silk Road, introducing woven gold brocades, Sassanian roundel motifs, and even trousers for noble women who rode horses. The huadian — a decorative painted or pasted flower on the forehead — became the signature Tang beauty mark. Men's fashion featured round-collared robes with narrow sleeves and leather boots. The Tang court issued detailed sumptuary laws governing which colors, fabrics, and ornamentation each social rank could wear.",
    destination: "Xi'an (Daming Palace ruins host Tang costume festivals), Dunhuang (Mogao Caves murals vividly depict Tang fashion in Buddhist art).",
    destLabel: "Best places to experience"
  },
  {
    name: "Song", nameCN: "宋", period: "960 – 1279 AD",
    img: "https://images.unsplash.com/photo-1737861617257-8315fe445e98?q=80&w=687&h=458&fit=crop&crop=entropy&auto=format&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    desc: "Where Tang was bold, Song was restrained. Neo-Confucian philosophy emphasized modesty and simplicity, producing a fashion of refined understatement that still reads as modern today. Women's garments narrowed: sleeves became fitted at the wrist, silhouettes grew straighter and less voluminous.",
    details: "The beizi — a long, sleeveless or narrow-sleeved outer jacket worn open at the front — became the dynasty's signature piece, often reaching the ankles. Color palettes shifted to muted tones: celadon green, misty blue, pale lavender, ash gray. The literati scholar-official class drove men's fashion with simple, wide robes (daopao) and the iconic square-topped hat (putou). Embroidery became more refined as a domestic art, with Song embroiderers achieving unprecedented levels of detail on silk.",
    destination: "Hangzhou — the Southern Song imperial capital, where you can wear Song-style Hanfu by West Lake and visit the China National Silk Museum.",
    destLabel: "Best place to experience"
  },
  {
    name: "Ming", nameCN: "明", period: "1368 – 1644 AD",
    img: "https://images.unsplash.com/photo-1785665359067-b30c8c11ec5c?q=80&w=687&h=458&fit=crop&crop=entropy&auto=format&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    desc: "After nearly a century of Mongol Yuan rule, the Ming dynasty explicitly revived Han Chinese clothing traditions as an act of cultural restoration. The iconic mamianqun (horse-face skirt) emerged: a wrap-around pleated skirt with flat front and back panels, typically in bright red or blue brocade.",
    details: "Women paired these with stand-collar jackets (ao) that closed with ornate metal or jade buttons. The Ming introduced the buzi system — square embroidered rank badges sewn onto the chest and back of officials' robes, with birds denoting civil ranks and animals for military ranks. The circular collar (yuanlingpao) with coordinating cross-collar inner robe became the standard formal silhouette. Cloud-collar (yunjian) shawls with four cloud-shaped lobes were worn as decorative overlays. Ming fashion is the primary reference for today's Hanfu revival movement.",
    destination: "Beijing (Forbidden City and Ming Tombs), Nanjing (Ming Xiaoling Mausoleum — stunning red-wall photography backdrop).",
    destLabel: "Best places to experience"
  },
  {
    name: "Qing", nameCN: "清", period: "1644 – 1912",
    img: "/images/dyn-qing.webp",
    desc: "The Manchu conquest brought dramatic changes. The qizhuang (banner dress) introduced the changyi — a long, straight robe with side slits and wide sleeves with folded cuffs — which directly influenced the modern qipao. Manchu women wore a distinctive three-earring style and platform shoes with elevated central heels.",
    details: "Han men were required to adopt the Manchu queue hairstyle (shaved forehead with a long braid), though Han women largely retained Ming-style dress for informal occasions. Court dress reached its apex of elaboration: officials wore layered dragon robes (jifu for semi-formal, chaofu for the most ceremonial occasions) with intricate rank badges, and empresses and high-ranking consorts wore phoenix coronets adorned with kingfisher feather inlay. The Qing textile industry produced some of history's most elaborate silk embroidery.",
    destination: "Shenyang (Mukden Palace, the original Manchu imperial seat), Beijing (Forbidden City Qing collections), Shanghai (where the Qing changyi evolved into the 1920s qipao).",
    destLabel: "Best places to experience"
  },
  {
    name: "Republican Era", nameCN: "民国", period: "1912 – 1949",
    img: "/images/dyn-republic.webp",
    desc: "The fall of the Qing in 1912 triggered China's most rapid fashion transformation. The 1920s Shanghai qipao (cheongsam) fused Manchu robe structure with Western tailoring: body-hugging darts, higher side slits, and luxurious imported fabrics.",
    details: "This was China's first genuinely modern women's garment, championed by socialites, movie stars, and the 'modern girl' (modeng nvlang) who defined Shanghai's jazz-age glamour. The 1930s qipao reached its peak — floor-length with high mandarin collars and delicate frog-button closures, often in printed silk. Simultaneously, the Zhongshan suit (based on Sun Yat-sen's design combining Western tailoring with Chinese symbolism) became the standard men's formalwear. The era also saw the rise of the first Chinese fashion magazines, department stores, and domestic designers.",
    destination: "Shanghai — the Bund's heritage architecture and the French Concession still echo this era. Visit the Shanghai History Museum for original 1930s qipaos.",
    destLabel: "Best place to experience"
  }
];

const dynastiesFAQs = [
  { q: "Which dynasty has the most iconic Hanfu style?", a: "The Tang Dynasty (618–907 AD) is widely considered the most iconic — its bold colors, chest-high ruqun skirts, and flowing silk shawls are instantly recognizable and heavily featured in films and TV dramas. Tang-style Hanfu is also the most popular for photoshoots today. The Ming Dynasty (1368–1644 AD) runs a close second, especially for the modern Hanfu revival movement which primarily references Ming styles." },
  { q: "How did Chinese clothing change from dynasty to dynasty?", a: "Each dynasty's clothing reflected its political philosophy and cultural values. The Han established the foundational silhouette (crossed collars, wide sleeves). The Tang embraced bold, cosmopolitan styles influenced by Silk Road trade. The Song favored restrained elegance under Neo-Confucianism. The Ming revived Han traditions after Mongol rule and introduced the iconic mamian skirt. The Qing imposed Manchu styles including the queue hairstyle and banner dress. The Republican Era fused Chinese and Western fashion into the modern qipao." },
  { q: "Where can I see authentic dynasty-era clothing today?", a: "The Palace Museum (Forbidden City) in Beijing holds the world's largest collection of imperial robes and textiles. The China National Silk Museum in Hangzhou is the largest silk and textile museum globally. The Shaanxi History Museum in Xi'an has Han and Tang dynasty textile remnants. The Shanghai Museum features Qing and Republican-era fashion. All four museums have English-language signage and are accessible to international visitors." },
  { q: "Can I wear Hanfu from different dynasties during one trip?", a: "Absolutely — and many travelers do exactly this. Xi'an is the best city for this: you can rent Han dynasty-style robes for the city wall, then switch to Tang dynasty ruqun for Daming Palace on the same day. Hangzhou is ideal for Song-style beizi by West Lake. Beijing offers Ming-style formal wear for Forbidden City photos. Most cities have rental shops near major attractions; plan 30–60 minutes per costume change including hair and makeup." },
];

const schemaDynastiesFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": dynastiesFAQs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
});
---

<BaseLayout
  title="Chinese Clothing by Dynasty: 2,000 Years of Fashion | ChinaStyle"
  description="Travel through 2,000 years of Chinese fashion. Each dynasty's clothing legacy — Han, Tang, Song, Ming, Qing, Republican Era — and the cities where you can still experience these styles today."
  ogImage="/images/og-dynasties.webp"
  articleDate="2026-08-06"
  canonicalUrl="/dynasties"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Dynasties", url: "/dynasties/" }]}>
  <section class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <span class="text-xs font-medium text-vermillion-600 tracking-[0.15em] uppercase">ChinaStyle Travel Guide</span>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-warm-900 mt-3">
        Chinese Clothing Across the Dynasties
      </h1>
      <p class="mt-6 text-lg text-warm-500 leading-relaxed max-w-2xl">
        Every Chinese dynasty had a distinctive fashion identity, and remarkably, you can still visit the cities that shaped them. Walk the Silk Road starting point in Xi'an (Han dynasty), explore Song dynasty elegance in Hangzhou, and trace Ming imperial style through Beijing and Nanjing.
      </p>

      <!-- Quick Jump -->
      <div class="mt-8 flex flex-wrap gap-2">
        {dynasties.map(d => (
          <a href={`#dynasty-${d.name.toLowerCase().replace(/\s+/g, '-')}`} class="text-xs px-3 py-1.5 bg-warm-100 rounded-full text-warm-600 hover:bg-warm-200 transition-colors">{d.nameCN} {d.name}</a>
        ))}
        <a href="#faq" class="text-xs px-3 py-1.5 bg-warm-100 rounded-full text-warm-600 hover:bg-warm-200 transition-colors">FAQ</a>
        <a href="#sources" class="text-xs px-3 py-1.5 bg-warm-100 rounded-full text-warm-600 hover:bg-warm-200 transition-colors">Sources</a>
      </div>

      <!-- Dynasty timeline overview -->
      <div class="mt-12 relative">
        <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-warm-200 -translate-x-1/2"></div>
        {dynasties.map((d, i) => (
          <div id={`dynasty-${d.name.toLowerCase().replace(/\s+/g, '-')}`} class={`relative mb-16 ${i % 2 === 0 ? 'lg:pr-[calc(50%+2rem)]' : 'lg:pl-[calc(50%+2rem)] lg:text-right'}`}>
            <!-- Timeline dot (desktop) -->
            <div class="hidden lg:flex absolute left-1/2 top-8 w-4 h-4 bg-vermillion-500 rounded-full -translate-x-1/2 shadow-[0_0_0_6px_rgba(181,52,58,0.12)] z-10"></div>

            <!-- Dynasty badge -->
            <span class="inline-block text-xs font-semibold text-vermillion-600 tracking-widest uppercase bg-vermillion-50 px-3 py-1 rounded-full mb-3">
              {d.period}
            </span>

            <!-- Image -->
            <div class="overflow-hidden rounded-xl aspect-[3/2] mb-5 bg-warm-100">
              <img
                src={d.img}
                alt={`${d.name} Dynasty (${d.nameCN}制) Chinese traditional clothing`}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading={i < 2 ? "eager" : "lazy"}
                width="1536" height="1024"
                decoding="async"
              />
            </div>

            <!-- Title -->
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-warm-900 mb-3">
              {d.name} Dynasty <span lang="zh" class="text-warm-400 font-normal">({d.nameCN}制)</span>
            </h2>

            <!-- Description -->
            <p class="text-warm-600 leading-relaxed">{d.desc}</p>
            <p class="text-warm-600 leading-relaxed mt-3">{d.details}</p>

            <!-- Destination tip -->
            <div class={`mt-5 p-4 bg-vermillion-50 border border-vermillion-100 rounded-xl ${i % 2 !== 0 ? 'lg:text-left' : ''}`}>
              <span class="text-xs font-semibold text-vermillion-600 tracking-wider uppercase">{d.destLabel}</span>
              <p class="text-sm text-warm-700 mt-1 leading-relaxed">{d.destination}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- FAQ Section -->
      <div id="faq" class="mt-16 pt-12 border-t border-warm-200">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-warm-900 mb-8">Frequently Asked Questions About Chinese Dynasties & Fashion</h2>
        <div class="space-y-6">
          {dynastiesFAQs.map(faq => (
            <div class="bg-warm-50 border border-warm-100 rounded-xl p-5">
              <h3 class="font-semibold text-warm-900 text-base">{faq.q}</h3>
              <p class="text-warm-600 text-sm leading-relaxed mt-2">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Sources -->
      <div id="sources" class="mt-16 pt-8 border-t border-warm-200">
        <h2 class="font-display text-lg font-semibold text-warm-900 mb-3">Sources & Further Reading</h2>
        <ul class="space-y-1 text-sm text-warm-500">
          <li>&bull; <a href="https://en.chinaculture.org/" class="text-vermillion-600 hover:underline" target="_blank" rel="noopener">China Culture.org</a> — Ministry of Culture official resource on Chinese heritage and traditions</li>
          <li>&bull; <a href="https://en.dpm.org.cn/" class="text-vermillion-600 hover:underline" target="_blank" rel="noopener">The Palace Museum</a> (Forbidden City, Beijing) — original imperial robes and textile collections</li>
          <li>&bull; <a href="https://www.chinasilkmuseum.com/" class="text-vermillion-600 hover:underline" target="_blank" rel="noopener">China National Silk Museum</a> (Hangzhou) — world's largest silk and textile museum</li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="mt-12 bg-warm-900 rounded-2xl p-8 sm:p-10 text-center">
        <h2 class="font-display text-xl sm:text-2xl font-bold text-white mb-3">Ready to Wear a Dynasty?</h2>
        <p class="text-warm-300 text-sm leading-relaxed max-w-lg mx-auto">Browse our <a href="/hanfu" class="text-white underline hover:text-warm-200">Hanfu guide</a> for detailed costume breakdowns, or jump to <a href="/plan-trip" class="text-white underline hover:text-warm-200">Plan Your Trip</a> for itineraries that put you in the right city in the right costume.</p>
      </div>

    </div>
  </section>

  <script type="application/ld+json" set:html={schemaDynastiesFAQ}></script>
</BaseLayout>
