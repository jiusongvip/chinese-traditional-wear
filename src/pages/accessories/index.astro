<BaseLayout
  title="Traditional Accessories: Where to Buy | ChinaStyle"
  description="Silk fans, jade pendants, hairpins, embroidered shoes — where to find authentic Chinese traditional accessories in Suzhou, Hangzhou, and Beijing markets."
  ogImage="/images/og-accessories.webp"
  canonicalUrl="/accessories"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Accessories", url: "/accessories/" }]}>
