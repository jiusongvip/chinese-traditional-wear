const travelFAQs = [
  { q: "Where can I try on Chinese traditional clothing in China?", a: "The best cities for hands-on experiences: Xi''an (Hanfu photoshoots at the ancient city wall and Daming Palace, costume rentals from 100-300 RMB), Shanghai (qipao tailoring in the French Concession, South Bund Fabric Market for custom pieces), Beijing (tang suit workshops in hutong tailor houses), Suzhou (silk qipao rentals for classical garden photoshoots), and Guizhou (Miao embroidery villages near Kaili where you can dress in full silver headdresses). Most major museums including the China National Silk Museum in Hangzhou offer costume try-on sessions." },
  { q: "Which city is best for Hanfu experiences?", a: "Xi''an tops the list  -  the ancient city wall, Daming Palace ruins, and Datang Everbright City are packed with Hanfu rental shops and photoshoot studios. Luoyang (Longmen Grottoes area) and Chengdu (Jinli Ancient Street) are close seconds, each with thriving Hanfu streets where locals and tourists alike stroll in period costume. For the most immersive experience, visit Xi''an during the annual Hanfu Culture Festival (usually in April)." },
  { q: "How much does a Hanfu rental and photoshoot cost?", a: "Typical costs: basic Hanfu rental 100-200 RMB for 2-4 hours including basic hairstyling; premium sets with professional makeup and hair 300-500 RMB; full photoshoot package with photographer 500-1500 RMB for 1-2 hours at iconic locations. Xi''an city wall has an entry fee of 54 RMB on top of rental. Most shops require a 200-500 RMB refundable deposit. Booking through Chinese apps like Meituan or Xiaohongshu often gets you 20-30% off walk-in prices." },
  { q: "Where can I buy authentic Chinese traditional clothing while traveling?", a: "Shanghai''s South Bund Fabric Market for custom qipao (3-5 day turnaround), Beijing''s Silk Street for tang suits and off-the-rack Hanfu, Suzhou for silk brocades and accessories, and Xi''an''s Muslim Quarter surroundings for Hanfu shops. For ethnic minority textiles, head to Kaili in Guizhou or Dali in Yunnan for authentic handmade pieces direct from artisans." },
];

const generalFAQs = [
  { q: "What is Chinese traditional wear called?", a: "The most common term is \"Hanfu\" for traditional Han Chinese clothing from ancient dynasties. \"Qipao\" or \"Cheongsam\" refers to the form-fitting dress popularized in 1920s Shanghai. \"Tang suit\" describes the mandarin-collared jacket worn for festivals and formal occasions. Each name refers to a different style, silhouette, and historical period." },
  { q: "What is the difference between Hanfu and Qipao?", a: "Hanfu dates back over 3,000 years and features loose, flowing robes with crossed collars and wide sleeves. Qipao emerged in 1920s Shanghai with a form-fitting, one-piece silhouette, high mandarin collar, and side slits. Hanfu represents ancient imperial China; Qipao represents modern Shanghai glamour and the fusion of East and West." },
  { q: "Is it appropriate for non-Chinese people to wear traditional Chinese clothing?", a: "Generally yes, when worn with respect and understanding of cultural context. Cultural appreciation vs. appropriation depends on intent and context: learning about and honoring the tradition is widely welcomed. Many Chinese cultural organizations and historical sites actively encourage visitors to try on traditional clothing as a way to engage with and celebrate Chinese heritage." },
  { q: "What did Chinese emperors wear?", a: "Chinese emperors wore the \"dragon robe\" (longpao) in brilliant yellow silk embroidered with nine dragons, clouds, waves, and the twelve imperial symbols. Yellow was reserved exclusively for the emperor. The robe was worn with a jeweled crown, jade belt, and ornate court beads. You can see original imperial robes at the Palace Museum in Beijing''s Forbidden City." },
];

const schemaHomeFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [...travelFAQs, ...generalFAQs].map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
