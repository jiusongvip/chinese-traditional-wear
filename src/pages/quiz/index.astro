---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Which Traditional Wear Suits You? Quiz | ChinaStyle"
  description="Take our quiz to find which Chinese traditional clothing matches your personality — Hanfu, Qipao, Tang suit, or Zhongshan suit. Discover your perfect style!"
  canonicalUrl="/quiz"
  articleDate="2026-08-03"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Style Quiz", url: "/quiz/" }]}>
  <section class="pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-medium text-[#b5343a] tracking-[0.15em] uppercase">Interactive</span>
      <h1 class="font-serif-sc text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-stone-900 mt-3">
        Which Chinese Traditional Wear Suits You?
      </h1>
      <p class="mt-6 text-lg text-stone-500 leading-relaxed max-w-2xl mx-auto">
        Answer a few questions about your travel style and personality, and we''ll match you with the perfect Chinese traditional clothing experience. Are you a flowing Hanfu romantic, a sleek qipao modernist, or a sharp Tang suit classic?
      </p>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
        <div class="bg-stone-50 rounded-xl p-5 border border-stone-100">
          <h2 class="font-semibold text-sm text-stone-900">Hanfu</h2>
          <p class="text-xs text-stone-500 mt-1">Flowing ancient robes for history lovers and romantics. Best for photoshoots at Xi''an city walls and classical gardens.</p>
        </div>
        <div class="bg-stone-50 rounded-xl p-5 border border-stone-100">
          <h2 class="font-semibold text-sm text-stone-900">Qipao</h2>
          <p class="text-xs text-stone-500 mt-1">Form-fitting 1920s Shanghai glamour. Perfect for evening events, custom tailoring, and elegant city photography.</p>
        </div>
        <div class="bg-stone-50 rounded-xl p-5 border border-stone-100">
          <h2 class="font-semibold text-sm text-stone-900">Tang Suit</h2>
          <p class="text-xs text-stone-500 mt-1">Mandarin-collar festival jacket with frog buttons. Ideal for Beijing hutong workshops and celebration wear.</p>
        </div>
        <div class="bg-stone-50 rounded-xl p-5 border border-stone-100">
          <h2 class="font-semibold text-sm text-stone-900">Zhongshan Suit</h2>
          <p class="text-xs text-stone-500 mt-1">Revolutionary formal menswear with four pockets. A wearable, tailored souvenir from Nanjing and Guangzhou.</p>
        </div>
      </div>
      <p class="mt-6 text-stone-400">Quiz coming soon — in the meantime, browse our <a href="/compare" class="text-[#b5343a] hover:underline">style comparisons</a> to find your match.</p>
    </div>
  </section>
</BaseLayout>
