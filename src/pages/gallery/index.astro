---
import BaseLayout from "../../layouts/BaseLayout.astro";

const galleryImages = [
  {
    src: "https://images.pexels.com/photos/36587320/pexels-photo-36587320.jpeg",
    alt: "Traditional Chinese Hanfu dress in elegant studio portrait",
    tag: "Studio · Hanfu",
    title: "Hanfu Portrait in Studio Lighting",
    desc: "A beautifully styled Hanfu portrait showcasing the flowing silhouette and intricate embroidery of traditional Chinese dress. Studio shoots are an excellent alternative when weather or timing doesn't permit outdoor photography — many rental shops in Xi'an and Chengdu offer indoor studio packages starting from 200 RMB."
  },
  {
    src: "https://images.pexels.com/photos/18077456/pexels-photo-18077456.jpeg",
    alt: "Chinese traditional clothing photoshoot at historic architecture",
    tag: "Architecture · Hanfu",
    title: "Hanfu at Historic Chinese Architecture",
    desc: "Traditional clothing comes alive against authentic backdrops. Historic architecture — whether a Ming dynasty courtyard, a Song dynasty temple, or a Qing-era garden — provides the most natural setting for Hanfu photography. The contrast between flowing silk robes and aged wooden structures creates a timeless aesthetic."
  },
  {
    src: "https://images.pexels.com/photos/16712432/pexels-photo-16712432.jpeg",
    alt: "Hanfu dress styled with traditional accessories and florals",
    tag: "Accessories · Hanfu",
    title: "Hanfu with Traditional Accessories & Florals",
    desc: "The full Hanfu experience includes accessories: jade hairpins, embroidered fans, and floral accents complete the look. Most rental shops include basic accessories in their packages. For premium shoots, bring your own props — paper parasols, calligraphy scrolls, or fresh flowers add personality to every frame."
  },
  {
    src: "/images/gallery-hanfu-xian.webp",
    alt: "Hanfu photoshoot at Xi'an ancient city wall",
    tag: "Xi'an · Hanfu",
    title: "Tang Dynasty Ruqun at the South Gate",
    desc: "Shoot at golden hour (5-6 PM) when the setting sun paints the ancient stone amber. The South Gate (Yongningmen) offers the cleanest backdrop — rent from shops on Shuyuanmen Street, 100m west. Best months: April and October."
  },
  {
    src: "/images/gallery-qipao-shanghai.webp",
    alt: "Qipao tailoring experience in Shanghai",
    tag: "Shanghai · Qipao",
    title: "Custom Cheongsam in the French Concession",
    desc: "South Bund Fabric Market (3F, 399 Lujiabang Rd) — pick silk from the ground floor, get measured upstairs, return in 3-5 days. For the French Concession backdrop: Fuxing Road's plane-tree tunnel in November is unmatched."
  },
  {
    src: "/images/gallery-miao-guizhou.webp",
    alt: "Miao embroidery workshop in Guizhou",
    tag: "Guizhou · Miao Attire",
    title: "Full Silver Headdress in Xijiang Village",
    desc: "Xijiang Miao Village (千户苗寨) — the world's largest Miao settlement. Dress in a genuine silver headdress (some weigh 5+ kg) and embroidered jacket. Visit during the Miao New Year (varies, usually November) for the most elaborate costumes. Guiyang to Kaili by high-speed train: 40 min."
  },
  {
    src: "/images/gallery-tang-beijing.webp",
    alt: "Tang suit workshop in Beijing hutong",
    tag: "Beijing · Tang Suit",
    title: "Mandarin-Collar Jacket in Nanluoguxiang",
    desc: "Nanluoguxiang's side alleys hide multi-generational tailor shops. A custom Tang suit with silk brocade and frog buttons runs 300-600 RMB, 3-4 day turnaround. Photograph against grey-brick hutong walls for maximum contrast — the red lanterns at dusk are a classic Beijing frame."
  },
  {
    src: "/images/gallery-silk-suzhou.webp",
    alt: "Silk market shopping in Suzhou",
    tag: "Suzhou · Silk Qipao",
    title: "Classical Garden Shoot in Humble Administrator's Garden",
    desc: "Rent a silk qipao on Pingjiang Road (80-150 RMB for 4 hours), then walk 10 minutes to the Humble Administrator's Garden (拙政园). Entry: 80 RMB. Shoot in the 'Far Away Looking Pavilion' section — moonlight gates and borrowed views make every frame painterly. The garden opens at 7:30 AM; go early for empty pathways."
  },
  {
    src: "/images/gallery-dunhuang-tang.webp",
    alt: "Dunhuang mural inspired Tang costume",
    tag: "Dunhuang · Tang Flying Apsaras",
    title: "Mogao Cave-Inspired Feitian Costume at Mingsha Dunes",
    desc: "The 'flying apsaras' (飞天) costume — ribbon sleeves, high-waisted skirt, layered silk sashes — is inspired by Cave 320's famous mural. Shops near the Mogao Caves visitor center rent these (200-400 RMB with hair and makeup). Shoot at Mingsha Mountain's Crescent Spring at sunrise: golden dunes, no tourists, the ribbons catch the desert wind."
  },
  {
    src: "https://images.unsplash.com/photo-1734594647541-170e761f58fe?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    alt: "Traditional Chinese wedding attire — couple in ceremonial Hanfu dress",
    tag: "Wedding · Ceremonial Hanfu",
    title: "Traditional Chinese Wedding Attire",
    desc: "Chinese wedding Hanfu is among the most elaborate traditional clothing you'll encounter — layered silk robes in auspicious red, intricate gold embroidery, and phoenix-and-dragon motifs. Many couples now choose Hanfu weddings as an alternative to Western-style ceremonies. If you're traveling during wedding season (spring and autumn), you may spot bridal photoshoots at historic sites across China."
  },
  {
    src: "https://images.unsplash.com/photo-1619107796968-a4802f920298?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    alt: "Traditional Chinese clothing experience at a cultural workshop",
    tag: "Workshop · Cultural Experience",
    title: "Hands-On Cultural Clothing Workshop",
    desc: "Beyond rental and photoshoots, many cities offer immersive workshops where you can learn about traditional clothing construction, try your hand at embroidery, or participate in a tea ceremony while dressed in period attire. These experiences are especially popular in Hangzhou (silk-related), Guizhou (Miao batik and embroidery), and Chengdu (Shu embroidery)."
  },
  {
    src: "https://images.pexels.com/photos/37670353/pexels-photo-37670353.jpeg",
    alt: "Elegant Chinese traditional dress in a modern setting",
    tag: "Modern · Fusion Style",
    title: "Traditional Meets Contemporary",
    desc: "The Hanfu revival isn't just about historical reenactment — it's a living fashion movement. Young designers blend traditional silhouettes with modern fabrics and cuts. In cities like Shanghai, Chengdu, and Hangzhou, you'll see people pairing a Ming dynasty mamian skirt with a modern blouse, or wearing a Tang-style jacket over jeans. This 'new Chinese style' (新中式) is one of China's most exciting fashion trends."
  }
];
---

<BaseLayout
  title="Chinese Traditional Wear Gallery | ChinaStyle"
  description="Photos of travelers in Chinese traditional clothing at iconic destinations — Xi'an city walls, Shanghai Bund, Beijing hutongs, Guizhou villages, and more. 12 inspiring images with location and planning tips."
  ogImage="/images/og-gallery.webp"
  canonicalUrl="/gallery"
  articleDate="2026-08-06"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Gallery", url: "/gallery/" }]}>
  <section class="pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-medium text-vermillion-600 tracking-[0.15em] uppercase">ChinaStyle Travel Gallery</span>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-warm-900 mt-3">
        Chinese Traditional Wear: A Visual Journey
      </h1>
      <p class="mt-6 text-lg text-warm-500 leading-relaxed max-w-2xl">
        See how travelers bring Chinese traditional clothing to life at the most beautiful destinations across China. From Hanfu photoshoots on ancient city walls to qipao fittings in art deco lanes — 12 inspiring images with location guides and practical tips.
      </p>

      <!-- Masonry Gallery -->
      <div class="mt-12 columns-2 md:columns-3 gap-4">
        {galleryImages.map((img) => (
          <div class="break-inside-avoid mb-4">
            <div class="overflow-hidden rounded-xl bg-warm-100 aspect-[3/4]">
              <img
                src={img.src}
                alt={img.alt}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
                width="1024" height="1536"
                decoding="async"
              />
            </div>
            <div class="mt-3 px-2">
              <span class="text-xs font-semibold text-vermillion-600 tracking-wider uppercase">{img.tag}</span>
              <h3 class="text-sm font-medium text-warm-800 mt-0.5">{img.title}</h3>
              <p class="text-xs text-warm-500 mt-1 leading-relaxed">{img.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Photo Checklist -->
      <h2 class="font-display text-2xl font-bold text-warm-900 mt-14 mb-4">Your Gallery Photo Checklist</h2>
      <p class="text-warm-600 leading-relaxed">Planning a traditional-wear photoshoot in China? Here's what to prepare:</p>
      <ul class="mt-4 space-y-3 text-warm-600 text-sm list-disc pl-5">
        <li><strong class="text-warm-800">Book your rental the day before</strong> — walk-ins work, but the best costumes go early. If you're shooting at sunrise, arrange pickup the evening prior.</li>
        <li><strong class="text-warm-800">Bring a portable steamer</strong> — rental costumes may have fold creases from storage. A travel steamer (Xiaomi Deerma, ~80 RMB on Taobao) fixes this in 5 minutes.</li>
        <li><strong class="text-warm-800">Wear nude undergarments</strong> — white or skin-toned seamless underwear. For Hanfu, a thin camisole and bike shorts prevent fabric from clinging. For qipao: shapewear or seamless thong.</li>
        <li><strong class="text-warm-800">Golden hour is your superpower</strong> — 30 minutes before sunset. In China, this varies by season: 5:30 PM (winter) to 7:00 PM (summer). Check a weather app for exact times.</li>
        <li><strong class="text-warm-800">Bring props from home</strong> — a paper fan (折扇), calligraphy brush, or vintage parasol looks more authentic than the rental shop's plastic alternatives. Buy these at local markets the day before.</li>
        <li><strong class="text-warm-800">Learn 3 poses before you go</strong> — search "汉服拍照姿势" on Xiaohongshu (RED) for pose guides. Save screenshots to show your photographer or friend.</li>
      </ul>

      <!-- CTA -->
      <div class="mt-14 bg-warm-900 rounded-2xl p-8 sm:p-10 text-center">
        <h2 class="font-display text-xl sm:text-2xl font-bold text-white mb-3">Want to Be Featured in Our Gallery?</h2>
        <p class="text-warm-300 text-sm leading-relaxed max-w-lg mx-auto">
          Browse our <a href="/hanfu" class="text-white underline hover:text-warm-200">Hanfu experiences</a> and <a href="/qipao-cheongsam" class="text-white underline hover:text-warm-200">qipao tailoring guides</a> to plan your own photoshoot. Not sure which style fits you? Check our <a href="/compare" class="text-white underline hover:text-warm-200">style comparisons</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
