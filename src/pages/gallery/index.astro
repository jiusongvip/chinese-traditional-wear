---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Chinese Traditional Wear Gallery | ChinaStyle"
  description="Photos of travelers in Chinese traditional clothing at iconic destinations — Xi'an city walls, Shanghai Bund, Beijing hutongs, Guizhou villages, and more."
  canonicalUrl="/gallery"
  articleDate="2026-08-03"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Gallery", url: "/gallery/" }]}>
  <section class="pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-medium text-[#b5343a] tracking-[0.15em] uppercase">ChinaStyle Travel Gallery</span>
      <h1 class="font-serif-sc text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-stone-900 mt-3">
        Chinese Traditional Wear: A Visual Journey
      </h1>
      <p class="mt-6 text-lg text-stone-500 leading-relaxed max-w-2xl">
        See how travelers bring Chinese traditional clothing to life at the most beautiful destinations across China. From Hanfu photoshoots on ancient city walls to qipao fittings in art deco lanes.
      </p>

      <div class="mt-12 columns-2 md:columns-3 gap-4">
        <div class="break-inside-avoid mb-4 overflow-hidden rounded-xl bg-stone-100 aspect-[3/4]">
          <img src="/images/gallery-hanfu-xian.webp" alt="Hanfu photoshoot at Xi'an ancient city wall" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="1024" height="1536" />
        </div>
        <div class="break-inside-avoid mb-4 overflow-hidden rounded-xl bg-stone-100 aspect-[4/5]">
          <img src="/images/gallery-qipao-shanghai.webp" alt="Qipao tailoring experience in Shanghai" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="1024" height="1536" />
        </div>
        <div class="break-inside-avoid mb-4 overflow-hidden rounded-xl bg-stone-100 aspect-[3/4]">
          <img src="/images/gallery-miao-guizhou.webp" alt="Miao embroidery workshop in Guizhou" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="1024" height="1536" />
        </div>
        <div class="break-inside-avoid mb-4 overflow-hidden rounded-xl bg-stone-100 aspect-[4/3]">
          <img src="/images/gallery-tang-beijing.webp" alt="Tang suit workshop in Beijing hutong" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="1024" height="1536" />
        </div>
        <div class="break-inside-avoid mb-4 overflow-hidden rounded-xl bg-stone-100 aspect-[4/5]">
          <img src="/images/gallery-silk-suzhou.webp" alt="Silk market shopping in Suzhou" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="1024" height="1536" />
        </div>
        <div class="break-inside-avoid mb-4 overflow-hidden rounded-xl bg-stone-100 aspect-[3/4]">
          <img src="/images/gallery-dunhuang-tang.webp" alt="Dunhuang mural inspired Tang costume" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="1024" height="1536" />
        </div>
      </div>

      <p class="mt-12 text-stone-500 leading-relaxed max-w-2xl">
        Want to be featured in our gallery? Browse our <a href="/hanfu" class="text-[#b5343a] hover:underline">Hanfu experiences</a> and <a href="/qipao-cheongsam" class="text-[#b5343a] hover:underline">qipao tailoring guides</a> to plan your own photoshoot. Not sure which style fits you? Check our <a href="/compare" class="text-[#b5343a] hover:underline">style comparisons</a>.
      </p>
    </div>
  </section>
</BaseLayout>
